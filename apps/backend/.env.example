NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://usuario:contrasena@127.0.0.1:5432/nexo_erp?schema=public
JWT_ACCESS_SECRET=reemplaza-por-un-secreto-aleatorio-de-32-caracteres

MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=reemplaza-por-el-usuario-de-mailtrap
MAILTRAP_SMTP_PASS=reemplaza-por-la-contrasena-de-mailtrap
MAILTRAP_FROM_EMAIL=from@example.com
MAILTRAP_FROM_NAME=NexoERP

# PayPal Orders API. Configura estas credenciales solo en el backend.
# Sandbox: https://api-m.sandbox.paypal.com
# Producción: https://api-m.paypal.com
PAYPAL_CLIENT_ID=reemplaza-por-tu-client-id
PAYPAL_CLIENT_SECRET=reemplaza-por-tu-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=reemplaza-por-el-id-del-webhook

# PayPal no admite UYU. Indica la moneda de cobro y cuántos UYU
# equivalen a una unidad de esa moneda (ej.: 40 significa 40 UYU = 1 USD).
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=40

MARKETPLACE_COMMISSION_PERCENT=2

# WhatsApp Cloud API (Meta) para enviar el código de verificación del teléfono
# durante el checkout. Crea una app en https://developers.facebook.com y
# vincula un número de WhatsApp Business.
WHATSAPP_ACCESS_TOKEN=reemplaza-por-el-token-de-acceso-de-meta
WHATSAPP_PHONE_NUMBER_ID=reemplaza-por-el-id-del-numero-de-whatsapp
WHATSAPP_API_VERSION=v23.0
# Opcional: nombre de la plantilla de autenticación aprobada en Meta (con
# parámetro de código en el cuerpo y botón COPY CODE). Meta rechaza los
# mensajes de texto libres iniciados por la empresa fuera de la ventana de
# 24 horas del comprador, así que en producción conviene usar la plantilla.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=es

# Zona horaria IANA para los cortes diarios, semanales y mensuales del
# dashboard. Debe existir en la base de datos de zonas horarias del sistema.
DASHBOARD_TIMEZONE=America/Montevideo
