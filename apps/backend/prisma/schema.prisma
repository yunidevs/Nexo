generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMINISTRADOR
  VENDEDOR
  ALMACENERO
}

enum TipoOperacionCliente {
  CREADO
  ACTUALIZADO
  DESACTIVADO
  ACTIVADO
}

enum TipoOperacionProveedor {
  CREADO
  ACTUALIZADO
  DESACTIVADO
  ACTIVADO
  COMPRA_REGISTRADA
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
  DEVOLUCION
}

enum EstadoPedidoMarketplace {
  PENDIENTE_PAGO
  PAGO_CONFIRMADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
  REEMBOLSADO
  REEMBOLSO_PENDIENTE
}

enum EstadoCompra {
  PENDIENTE
  RECIBIDA
}

enum EstadoVenta {
  CONFIRMADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
  MERCADO_PAGO
  PAYPAL
  /// Valor conservado para pagos históricos anteriores a la migración a PayPal.
  DLOCAL_GO
}

model Empresa {
  id                      String                   @id @default(uuid()) @db.Uuid
  nombre                  String                   @db.VarChar(120)
  sitioWeb                String?                  @map("sitio_web") @db.VarChar(2048)
  tasaImpuesto            Decimal                  @default(0) @map("tasa_impuesto") @db.Decimal(5, 2)
  tiendaActiva            Boolean                  @default(false) @map("tienda_activa")
  tiendaSlug              String?                  @unique @map("tienda_slug") @db.VarChar(100)
  costoEnvio              Decimal                  @default(0) @map("costo_envio") @db.Decimal(12, 2)
  usuarios                Usuario[]
  clientes                Cliente[]
  proveedores             Proveedor[]
  productos               Producto[]
  movimientosInventario   MovimientoInventario[]
  compras                 Compra[]
  ventas                  Venta[]
  categorias              Categoria[]
  cuentaMercadoPago       CuentaMercadoPago?
  estadosOAuthMarketplace EstadoOAuthMarketplace[]
  pedidosMarketplace      PedidoMarketplace[]
  creadaEn                DateTime                 @default(now()) @map("creada_en")
  actualizadaEn           DateTime                 @updatedAt @map("actualizada_en")

  @@map("empresas")
}

model Usuario {
  id                      String                   @id @default(uuid()) @db.Uuid
  empresaId               String                   @map("empresa_id") @db.Uuid
  empresa                 Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre                  String                   @db.VarChar(80)
  apellido                String                   @db.VarChar(80)
  correo                  String                   @unique @db.VarChar(254)
  contrasenaHash          String                   @map("contrasena_hash") @db.VarChar(255)
  rol                     Rol                      @default(ADMINISTRADOR)
  activo                  Boolean                  @default(true)
  creadaEn                DateTime                 @default(now()) @map("creada_en")
  actualizadaEn           DateTime                 @updatedAt @map("actualizada_en")
  tokenRecuperacion       PasswordResetToken?
  movimientosInventario   MovimientoInventario[]
  operacionesClientes     OperacionCliente[]
  operacionesProveedores  OperacionProveedor[]
  compras                 Compra[]
  pagosCompras            PagoCompra[]
  ventas                  Venta[]
  ventasCanceladas        Venta[]                  @relation("VentaCancelador")
  pagosVentas             PagoVenta[]
  estadosOAuthMarketplace EstadoOAuthMarketplace[]

  @@index([empresaId])
  @@map("usuarios")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("usuario_id") @db.Uuid
  user      Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expira_en")
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([expiresAt])
  @@map("tokens_recuperacion_contrasena")
}

model Cliente {
  id            String             @id @default(uuid()) @db.Uuid
  empresaId     String             @map("empresa_id") @db.Uuid
  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre        String             @db.VarChar(80)
  apellido      String?            @db.VarChar(80)
  documento     String?            @db.VarChar(40)
  telefono      String?            @db.VarChar(40)
  correo        String?            @db.VarChar(254)
  direccion     String?            @db.VarChar(300)
  activo        Boolean            @default(true)
  creadaEn      DateTime           @default(now()) @map("creada_en")
  actualizadaEn DateTime           @updatedAt @map("actualizada_en")
  operaciones   OperacionCliente[]
  ventas        Venta[]

  @@index([empresaId, creadaEn])
  @@index([empresaId, activo])
  @@map("clientes")
}

model OperacionCliente {
  id        String               @id @default(uuid()) @db.Uuid
  clienteId String               @map("cliente_id") @db.Uuid
  cliente   Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuarioId String?              @map("usuario_id") @db.Uuid
  usuario   Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tipo      TipoOperacionCliente
  detalle   String               @db.VarChar(500)
  creadaEn  DateTime             @default(now()) @map("creada_en")

  @@index([clienteId, creadaEn])
  @@index([usuarioId])
  @@map("operaciones_clientes")
}

model Proveedor {
  id            String               @id @default(uuid()) @db.Uuid
  empresaId     String               @map("empresa_id") @db.Uuid
  empresa       Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre        String               @db.VarChar(120)
  documento     String?              @db.VarChar(40)
  telefono      String?              @db.VarChar(40)
  correo        String?              @db.VarChar(254)
  direccion     String?              @db.VarChar(300)
  activo        Boolean              @default(true)
  creadaEn      DateTime             @default(now()) @map("creada_en")
  actualizadaEn DateTime             @updatedAt @map("actualizada_en")
  operaciones   OperacionProveedor[]
  compras       Compra[]

  @@index([empresaId, creadaEn])
  @@index([empresaId, activo])
  @@map("proveedores")
}

model Producto {
  id                   String                     @id @default(uuid()) @db.Uuid
  empresaId            String                     @map("empresa_id") @db.Uuid
  empresa              Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sku                  String                     @db.VarChar(80)
  nombre               String                     @db.VarChar(120)
  precioVenta          Decimal                    @map("precio_venta") @db.Decimal(12, 2)
  costo                Decimal                    @db.Decimal(12, 2)
  stockMinimo          Int                        @map("stock_minimo")
  stock                Int                        @default(0)
  categoria            String?                    @db.VarChar(100)
  imagenUrl            String?                    @map("imagen_url") @db.VarChar(2048)
  activo               Boolean                    @default(true)
  publicadoMarketplace Boolean                    @default(false) @map("publicado_marketplace")
  stockReservado       Int                        @default(0) @map("stock_reservado")
  creadaEn             DateTime                   @default(now()) @map("creada_en")
  actualizadaEn        DateTime                   @updatedAt @map("actualizada_en")
  movimientos          MovimientoInventario[]
  detallesCompra       DetalleCompra[]
  detallesVenta        DetalleVenta[]
  detallesMarketplace  DetallePedidoMarketplace[]

  @@unique([empresaId, sku])
  @@index([empresaId, creadaEn])
  @@index([empresaId, activo])
  @@index([empresaId, categoria])
  @@map("productos")
}

model Categoria {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre        String   @db.VarChar(80)
  descripcion   String?  @db.VarChar(300)
  activo        Boolean  @default(true)
  creadaEn      DateTime @default(now()) @map("creada_en")
  actualizadaEn DateTime @updatedAt @map("actualizada_en")

  @@index([empresaId, creadaEn])
  @@index([empresaId, activo])
  @@map("categorias")
}

model MovimientoInventario {
  id            String                   @id @default(uuid()) @db.Uuid
  empresaId     String                   @map("empresa_id") @db.Uuid
  empresa       Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  productoId    String                   @map("producto_id") @db.Uuid
  producto      Producto                 @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuarioId     String?                  @map("usuario_id") @db.Uuid
  usuario       Usuario?                 @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tipo          TipoMovimientoInventario
  cantidad      Int
  stockAnterior Int                      @map("stock_anterior")
  stockNuevo    Int                      @map("stock_nuevo")
  motivo        String                   @db.VarChar(300)
  creadaEn      DateTime                 @default(now()) @map("creada_en")

  @@index([empresaId, creadaEn])
  @@index([productoId, creadaEn])
  @@map("movimientos_inventario")
}

model OperacionProveedor {
  id          String                 @id @default(uuid()) @db.Uuid
  proveedorId String                 @map("proveedor_id") @db.Uuid
  proveedor   Proveedor              @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  usuarioId   String?                @map("usuario_id") @db.Uuid
  usuario     Usuario?               @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tipo        TipoOperacionProveedor
  detalle     String                 @db.VarChar(500)
  fechaCompra DateTime?              @map("fecha_compra")
  total       Decimal?               @db.Decimal(12, 2)
  creadaEn    DateTime               @default(now()) @map("creada_en")

  @@index([proveedorId, creadaEn])
  @@index([usuarioId])
  @@map("operaciones_proveedores")
}

model Compra {
  id          String          @id @default(uuid()) @db.Uuid
  empresaId   String          @map("empresa_id") @db.Uuid
  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  proveedorId String          @map("proveedor_id") @db.Uuid
  proveedor   Proveedor       @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  usuarioId   String?         @map("usuario_id") @db.Uuid
  usuario     Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  estado      EstadoCompra    @default(PENDIENTE)
  total       Decimal         @db.Decimal(12, 2)
  fechaCompra DateTime        @map("fecha_compra") @db.Date
  creadaEn    DateTime        @default(now()) @map("creada_en")
  recibidaEn  DateTime?       @map("recibida_en")
  detalles    DetalleCompra[]
  pagos       PagoCompra[]

  @@index([empresaId, creadaEn])
  @@index([proveedorId, creadaEn])
  @@map("compras")
}

model DetalleCompra {
  id            String   @id @default(uuid()) @db.Uuid
  compraId      String   @map("compra_id") @db.Uuid
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  productoId    String   @map("producto_id") @db.Uuid
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad      Int
  costoUnitario Decimal  @map("costo_unitario") @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)

  @@index([compraId])
  @@index([productoId])
  @@map("detalles_compras")
}

model PagoCompra {
  id        String     @id @default(uuid()) @db.Uuid
  compraId  String     @map("compra_id") @db.Uuid
  compra    Compra     @relation(fields: [compraId], references: [id], onDelete: Cascade)
  usuarioId String?    @map("usuario_id") @db.Uuid
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  metodo    MetodoPago
  monto     Decimal    @db.Decimal(12, 2)
  creadaEn  DateTime   @default(now()) @map("creada_en")

  @@index([compraId, creadaEn])
  @@map("pagos_compras")
}

model Venta {
  id                String             @id @default(uuid()) @db.Uuid
  empresaId         String             @map("empresa_id") @db.Uuid
  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteId         String             @map("cliente_id") @db.Uuid
  cliente           Cliente            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuarioId         String?            @map("usuario_id") @db.Uuid
  usuario           Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  estado            EstadoVenta        @default(CONFIRMADA)
  canceladaEn       DateTime?          @map("cancelada_en")
  canceladaPorId    String?            @map("cancelada_por_id") @db.Uuid
  canceladaPor      Usuario?           @relation("VentaCancelador", fields: [canceladaPorId], references: [id], onDelete: SetNull)
  subtotal          Decimal            @db.Decimal(12, 2)
  descuento         Decimal            @db.Decimal(12, 2)
  tasaImpuesto      Decimal            @map("tasa_impuesto") @db.Decimal(5, 2)
  impuesto          Decimal            @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  costoEnvio        Decimal            @default(0) @map("costo_envio") @db.Decimal(12, 2)
  creadaEn          DateTime           @default(now()) @map("creada_en")
  detalles          DetalleVenta[]
  pagos             PagoVenta[]
  pedidoMarketplace PedidoMarketplace?

  @@index([empresaId, creadaEn])
  @@index([empresaId, estado, creadaEn])
  @@index([clienteId, creadaEn])
  @@map("ventas")
}

model DetalleVenta {
  id             String   @id @default(uuid()) @db.Uuid
  ventaId        String   @map("venta_id") @db.Uuid
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     String   @map("producto_id") @db.Uuid
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)

  @@index([ventaId])
  @@index([productoId])
  @@map("detalles_ventas")
}

model PagoVenta {
  id        String     @id @default(uuid()) @db.Uuid
  ventaId   String     @map("venta_id") @db.Uuid
  venta     Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  usuarioId String?    @map("usuario_id") @db.Uuid
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  metodo    MetodoPago
  monto     Decimal    @db.Decimal(12, 2)
  creadaEn  DateTime   @default(now()) @map("creada_en")

  @@index([ventaId, creadaEn])
  @@map("pagos_ventas")
}

model CuentaMercadoPago {
  id                   String   @id @default(uuid()) @db.Uuid
  empresaId            String   @unique @map("empresa_id") @db.Uuid
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioMercadoPagoId String   @map("usuario_mercado_pago_id") @db.VarChar(80)
  accessTokenCifrado   String   @map("access_token_cifrado") @db.Text
  refreshTokenCifrado  String   @map("refresh_token_cifrado") @db.Text
  venceEn              DateTime @map("vence_en")
  creadaEn             DateTime @default(now()) @map("creada_en")
  actualizadaEn        DateTime @updatedAt @map("actualizada_en")

  @@map("cuentas_mercado_pago")
}

model EstadoOAuthMarketplace {
  id         String   @id @default(uuid()) @db.Uuid
  estadoHash String   @unique @map("estado_hash") @db.VarChar(64)
  empresaId  String   @map("empresa_id") @db.Uuid
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId  String   @map("usuario_id") @db.Uuid
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn   DateTime @map("expira_en")
  creadaEn   DateTime @default(now()) @map("creada_en")

  @@index([expiraEn])
  @@index([empresaId])
  @@index([usuarioId])
  @@map("estados_oauth_marketplace")
}

model PedidoMarketplace {
  id                String                     @id @default(uuid()) @db.Uuid
  empresaId         String                     @map("empresa_id") @db.Uuid
  empresa           Empresa                    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  ventaId           String?                    @unique @map("venta_id") @db.Uuid
  venta             Venta?                     @relation(fields: [ventaId], references: [id], onDelete: SetNull)
  estado            EstadoPedidoMarketplace    @default(PENDIENTE_PAGO)
  nombreComprador   String                     @map("nombre_comprador") @db.VarChar(160)
  correoComprador   String                     @map("correo_comprador") @db.VarChar(254)
  telefonoComprador String                     @map("telefono_comprador") @db.VarChar(40)
  departamento      String                     @db.VarChar(80)
  localidad         String                     @db.VarChar(120)
  direccion         String                     @db.VarChar(300)
  codigoPostal      String?                    @map("codigo_postal") @db.VarChar(20)
  notaEntrega       String?                    @map("nota_entrega") @db.VarChar(500)
  subtotal          Decimal                    @db.Decimal(12, 2)
  tasaImpuesto      Decimal                    @map("tasa_impuesto") @db.Decimal(5, 2)
  impuesto          Decimal                    @db.Decimal(12, 2)
  costoEnvio        Decimal                    @map("costo_envio") @db.Decimal(12, 2)
  total             Decimal                    @db.Decimal(12, 2)
  comision          Decimal                    @db.Decimal(12, 2)
  preferenciaId     String?                    @unique @map("preferencia_id") @db.VarChar(100)
  pagoMercadoPagoId String?                    @unique @map("pago_mercado_pago_id") @db.VarChar(100)
  paypalOrderId     String?                    @unique @map("paypal_order_id") @db.VarChar(100)
  paypalCaptureId   String?                    @unique @map("paypal_capture_id") @db.VarChar(100)
  paypalRedirectUrl String?                    @map("paypal_redirect_url") @db.VarChar(2048)
  paypalAmount      Decimal?                   @map("paypal_amount") @db.Decimal(12, 2)
  paypalCurrency    String?                    @map("paypal_currency") @db.VarChar(3)
  idempotencyKey    String?                    @unique @map("idempotency_key") @db.VarChar(100)
  idempotencyRequestHash String?               @map("idempotency_request_hash") @db.Char(64)
  paypalRefundId    String?                    @unique @map("paypal_refund_id") @db.VarChar(100)
  expiraEn          DateTime                   @map("expira_en")
  pagadaEn          DateTime?                  @map("pagada_en")
  creadaEn          DateTime                   @default(now()) @map("creada_en")
  actualizadaEn     DateTime                   @updatedAt @map("actualizada_en")
  detalles          DetallePedidoMarketplace[]

  @@index([empresaId, estado, creadaEn])
  @@index([estado, expiraEn])
  @@map("pedidos_marketplace")
}

model DetallePedidoMarketplace {
  id             String            @id @default(uuid()) @db.Uuid
  pedidoId       String            @map("pedido_id") @db.Uuid
  pedido         PedidoMarketplace @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId     String            @map("producto_id") @db.Uuid
  producto       Producto          @relation(fields: [productoId], references: [id], onDelete: Restrict)
  sku            String            @db.VarChar(80)
  nombre         String            @db.VarChar(120)
  cantidad       Int
  precioUnitario Decimal           @map("precio_unitario") @db.Decimal(12, 2)
  subtotal       Decimal           @db.Decimal(12, 2)

  @@index([pedidoId])
  @@index([productoId])
  @@map("detalles_pedidos_marketplace")
}

enum EstadoEventoWebhookPayPal {
  PROCESANDO
  PROCESADO
  IGNORADO
}

model EventoWebhookPayPal {
  id          String                   @id @db.VarChar(100)
  tipo        String                   @db.VarChar(100)
  estado      EstadoEventoWebhookPayPal @default(PROCESANDO)
  pedidoId    String?                  @map("pedido_id") @db.Uuid
  recibidoEn  DateTime                 @default(now()) @map("recibido_en")
  procesadoEn DateTime?                @map("procesado_en")

  @@index([estado, recibidoEn])
  @@map("paypal_webhook_events")
}

model CodigoVerificacionTelefono {
  id           String    @id @default(uuid()) @db.Uuid
  telefono     String    @db.VarChar(20)
  codigoHash   String    @map("codigo_hash") @db.Char(64)
  intentos     Int       @default(0)
  verificadoEn DateTime? @map("verificado_en")
  expiraEn     DateTime  @map("expira_en")
  creadaEn     DateTime  @default(now()) @map("creada_en")

  @@index([telefono, creadaEn])
  @@index([telefono, verificadoEn])
  @@map("codigos_verificacion_telefono")
}
